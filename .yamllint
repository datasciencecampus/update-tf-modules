extends: default

rules:
  # GitHub workflow files commonly omit document start markers.
  document-start: disable

  # 80 chars is often too strict for actions SHAs, expressions, and URLs.
  line-length:
    max: 120
    allow-non-breakable-words: true

  # Keep native GitHub Actions syntax without quoting keys like "on".
  truthy:
    check-keys: false

  # Allow one space before inline comments for compact pinned action lines.
  comments:
    min-spaces-from-content: 1